# ---------------------------------------------------------------------------
# Joomla! extension repository
# This repository holds the extension sources only, not a Joomla installation.
# ---------------------------------------------------------------------------

# Build output and release packages
/build/
/dist/
/releases/
/tmp/
*.zip
*.tar
*.tar.gz
*.tgz

# Dependencies (lock files are intentionally NOT ignored - commit them)
/vendor/
/node_modules/
composer.phar
.yarn/
.pnp.*

# PHP tooling caches and reports
.php-cs-fixer.cache
.php_cs.cache
.phpcs-cache
.phpunit.result.cache
/.phpunit.cache/
/coverage/
clover.xml
junit.xml

# JavaScript tooling
.eslintcache
.npm/
npm-debug.log*
yarn-error.log*

# Environment and local overrides
.env
.env.*
!.env.example

# Joomla runtime artefacts - only show up when the extension is symlinked
# or deployed into a test site inside this working copy
configuration.php
/cache/
/logs/
*.log
error_log

# Editors and IDEs
# .idea/ is deliberately not listed: PhpStorm maintains its own .idea/.gitignore
# for the volatile files and the shareable project settings are committed.
# Uncomment the next line if you would rather keep IDE settings out of the repo.
# .idea/
.vscode/
.fleet/
nbproject/
.project
.settings/
.buildpath
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating system
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json
